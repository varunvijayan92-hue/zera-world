# Local development
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
JWT_SECRET="replace-with-secure-random-secret"
NEXTAUTH_SECRET="replace-with-secure-random-secret"

# Razorpay test credentials (keep empty until live approval)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="razorpay"

# Optional marketplace integration values
AMAZON_ACCESS_KEY_ID=""
AMAZON_SECRET_ACCESS_KEY=""
AMAZON_PARTNER_TAG=""
FLIPKART_ACCESS_TOKEN=""

# Production (set in Vercel or hosting provider)
# APP_URL="https://your-domain.vercel.app"
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
# NEXTAUTH_URL="https://your-domain.vercel.app"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# JWT_SECRET="replace-with-secure-random-secret"
# NEXTAUTH_SECRET="replace-with-secure-random-secret"
# NODE_ENV="production"
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional compatible Photon server for address suggestions
GEOCODING_BASE_URL=https://photon.komoot.io
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base64 encoded random 32-byte key; server only. Keep stable across deployments.
INTEGRATION_ENCRYPTION_KEY=
DELHIVERY_API_TOKEN=

# Public Contact Us business details; leave blank until confirmed.
SUPPORT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zera's World <support@zerasworld.in>"
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_ADDRESS=support@zerasworld.in
RESEND_FORWARD_TO=supportzerasworld@gmail.com
RESEND_FORWARD_FROM=support@zerasworld.in
SUPPORT_PHONE=
BUSINESS_ADDRESS=
SUPPORT_HOURS=
SUPPORT_RESPONSE_TIME=
