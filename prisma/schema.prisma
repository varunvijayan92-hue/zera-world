generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  loginId              String?              @unique
  sessionVersion       Int                  @default(0)
  passwordHash         String
  fullName             String
  role                 UserRole             @default(STAFF)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  auditLogs            AuditLog[]
  marketplaceAccounts  MarketplaceAccount[]
  supplierContacts     SupplierContact[]
  syncJobs             SyncJob[]
  phone                String?
  language             String               @default("en")
  notificationsEnabled Boolean              @default(true)
  customerOrders       CustomerOrder[]
  addresses            CustomerAddress[]
  supportTickets       SupportTicket[]
  vouchers             CustomerVoucher[]
  customerReturns      ReturnRequest[]
  loginChallenge       CustomerLoginChallenge?
}

model CustomerLoginChallenge {
  userId         String   @id
  challengeId    String   @unique
  digest         String
  sessionVersion Int
  attempts       Int      @default(0)
  expiresAt      DateTime
  sentAt         DateTime
  windowStart    DateTime
  sendCount      Int      @default(1)
  consumedAt     DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RolePermission {
  id        String           @id @default(cuid())
  role      UserRole
  action    PermissionAction
  resource  String
  createdAt DateTime         @default(now())

  @@unique([role, action, resource])
}

model Supplier {
  id                      String                   @id @default(cuid())
  sourceType              String                   @default("DIRECT")
  pickupAddress           String?
  companyName             String
  contactName             String?
  email                   String?
  phone                   String?
  website                 String?
  status                  SupplierStatus           @default(ACTIVE)
  taxId                   String?
  businessType            String?
  returnPolicy            String?
  paymentTerms            String?
  minOrderQty             Decimal?                 @db.Decimal(10, 2)
  leadTimeDays            Int?
  shippingCharges         Decimal?                 @db.Decimal(10, 2)
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  autoOrderProcessing     Boolean                  @default(false)
  connectionStatus        String?                  @default("PENDING")
  country                 String?
  currency                String?                  @default("INR")
  estimatedDeliveryDays   Int?
  integrationType         String?                  @default("MANUAL")
  processingTimeDays      Int?
  provider                String?
  returnAddress           String?
  shippingDestinations    String?
  products                Product[]
  purchaseOrders          PurchaseOrder[]
  returnRequests          ReturnRequest[]
  contacts                SupplierContact[]
  supplierProducts        SupplierProduct[]
  supplierProductMappings SupplierProductMapping[]
  settlements             SupplierSettlement[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  userId     String?
  name       String
  email      String?
  phone      String?
  position   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([supplierId])
  @@index([userId])
}

model StoreCategory {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  description   String    @default("")
  imageUrl      String?
  imagePublicId String?
  sortOrder     Int       @default(0)
  isVisible     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id                      String                      @id @default(cuid())
  supplierId              String?
  name                    String
  sku                     String                      @unique
  barcode                 String?
  description             String?
  category                String?
  categoryId              String?
  storeCategory           StoreCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                   String?
  status                  ProductStatus               @default(DRAFT)
  costPrice               Decimal?                    @db.Decimal(12, 2)
  sellingPrice            Decimal?                    @db.Decimal(12, 2)
  gstRate                 Decimal                     @default(5) @db.Decimal(5, 2)
  handlingCharge          Decimal                     @default(0) @db.Decimal(12, 2)
  returnDays              Int                         @default(7)
  isReturnable            Boolean                     @default(true)
  dimensions              String?
  weightKg                Decimal?                    @db.Decimal(10, 3)
  taxClassification       String?
  imageUrls               String[]                    @default([])
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  inventory               Inventory[]
  marketplaceMappings     MarketplaceProductMapping[]
  orderItems              OrderItem[]
  supplier                Supplier?                   @relation(fields: [supplierId], references: [id])
  productCosts            ProductCost[]
  variants                ProductVariant[]
  supplierProducts        SupplierProduct[]
  supplierProductMappings SupplierProductMapping[]

  @@index([supplierId])
  @@index([sku])
  @@index([categoryId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  variantName String
  sku         String   @unique
  barcode     String?
  price       Decimal? @db.Decimal(12, 2)
  costPrice   Decimal? @db.Decimal(12, 2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SupplierProduct {
  id                   String   @id @default(cuid())
  supplierId           String
  productId            String
  supplierProductCode  String
  supplierSku          String?
  purchasePrice        Decimal? @db.Decimal(12, 2)
  minimumOrderQuantity Int?
  dispatchTimeDays     Int?
  shippingCharges      Decimal? @db.Decimal(10, 2)
  isPreferred          Boolean  @default(false)
  lastUpdatedAt        DateTime @default(now())
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierProductCode])
  @@index([supplierId])
  @@index([productId])
}

model SupplierProductMapping {
  id                    String    @id @default(cuid())
  productId             String
  variantId             String?
  supplierId            String
  externalProductId     String?
  supplierSku           String?
  supplierVariantId     String?
  supplierProductUrl    String?
  purchaseCost          Decimal?  @db.Decimal(12, 2)
  currency              String?   @default("INR")
  shippingCost          Decimal?  @db.Decimal(12, 2)
  shippingDestination   String?
  lastStockCheckAt      DateTime?
  supplierAvailability  String?   @default("UNKNOWN")
  estimatedDeliveryDays Int?
  mappingStatus         String?   @default("ACTIVE")
  isPreferred           Boolean   @default(false)
  isFallback            Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier              Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([supplierId])
  @@index([mappingStatus])
}

model Warehouse {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  address     String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]
}

model Inventory {
  id            String          @id @default(cuid())
  productId     String
  warehouseId   String?
  supplierId    String?
  availableQty  Int             @default(0)
  reservedQty   Int             @default(0)
  damagedQty    Int             @default(0)
  incomingQty   Int             @default(0)
  status        InventoryStatus @default(AVAILABLE)
  safetyStock   Int             @default(0)
  lastUpdatedAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String
  orderNumber String              @unique
  status      OrderStatus         @default(PENDING)
  totalAmount Decimal?            @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String?
  sku             String?
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model MarketplaceAccount {
  id                    String               @id @default(cuid())
  userId                String
  marketplaceType       MarketplaceType
  accountName           String
  merchantId            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  status                String               @default("NOT_CONNECTED")
  authData              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings              MarketplaceListing[]
  syncJobs              SyncJob[]

  @@unique([userId, marketplaceType])
  @@index([marketplaceType])
}

model MarketplaceListing {
  id                   String                      @id @default(cuid())
  marketplaceAccountId String
  productId            String?
  marketplaceSku       String
  externalListingId    String?
  title                String?
  status               String                      @default("ACTIVE")
  price                Decimal?                    @db.Decimal(12, 2)
  stockQuantity        Int                         @default(0)
  lastSyncedAt         DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  marketplaceAccount   MarketplaceAccount          @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  productMappings      MarketplaceProductMapping[]

  @@unique([marketplaceAccountId, marketplaceSku])
  @@index([marketplaceAccountId])
}

model MarketplaceProductMapping {
  id                     String              @id @default(cuid())
  productId              String
  supplierProductId      String?
  supplierSku            String?
  internalSku            String?
  amazonMarketplaceSku   String?
  flipkartMarketplaceSku String?
  amazonListingId        String?
  flipkartListingId      String?
  marketplaceListingId   String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  marketplaceListing     MarketplaceListing? @relation(fields: [marketplaceListingId], references: [id])
  product                Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, amazonMarketplaceSku])
  @@unique([productId, flipkartMarketplaceSku])
  @@index([productId])
}

model PaymentTransaction {
  id                    String          @id @default(cuid())
  orderId               String
  provider              PaymentProvider @default(RAZORPAY)
  gatewayOrderId        String?
  gatewayPaymentId      String?
  amount                Decimal?        @db.Decimal(12, 2)
  currency              String          @default("INR")
  paymentStatus         PaymentStatus   @default(PENDING)
  idempotencyKey        String          @unique
  webhookEventId        String?
  verificationTimestamp DateTime?
  refundReference       String?
  refundStatus          String?         @default("NOT_REQUESTED")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId])
  @@index([paymentStatus])
  @@index([gatewayPaymentId])
}

model SupplierApprovalDecision {
  id                 String                 @id @default(cuid())
  marketplaceType    MarketplaceType
  marketplaceOrderId String
  supplierId         String?
  supplierName       String
  productId          String?
  customerName       String?
  orderId            String?
  status             SupplierApprovalStatus @default(PENDING)
  action             SupplierApprovalAction @default(MANUAL_APPROVAL)
  decisionReason     String?
  idempotencyKey     String                 @unique
  reviewerName       String?
  reviewedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([marketplaceType])
}

model CustomerOrder {
  customerId         String?
  customer           User?           @relation(fields: [customerId], references: [id])
  deliveredAt        DateTime?
  taxAmount          Decimal?        @db.Decimal(12, 2)
  handlingAmount     Decimal?        @db.Decimal(12, 2)
  id                 String          @id @default(cuid())
  marketplaceType    MarketplaceType
  marketplaceOrderId String
  customerName       String?
  shippingAddress    Json?
  status             OrderStatus     @default(PENDING)
  subtotal           Decimal?        @db.Decimal(12, 2)
  shippingAmount     Decimal?        @db.Decimal(12, 2)
  totalAmount        Decimal?        @db.Decimal(12, 2)
  orderDate          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  orderItems         OrderItem[]
  returns            ReturnRequest[]
  shipments          Shipment[]

  @@unique([marketplaceType, marketplaceOrderId])
  @@index([customerId, createdAt])
  @@index([status])
}

model OrderItem {
  returns           ReturnRequest[]
  costPrice         Decimal?        @db.Decimal(12, 2)
  gstRate           Decimal?        @db.Decimal(5, 2)
  handlingCharge    Decimal?        @db.Decimal(12, 2)
  returnDays        Int?
  isReturnable      Boolean?
  fulfillmentStatus String          @default("PENDING")
  id                String          @id @default(cuid())
  customerOrderId   String
  productId         String?
  marketplaceSku    String?
  supplierId        String?
  quantity          Int
  unitPrice         Decimal?        @db.Decimal(12, 2)
  status            OrderStatus     @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerOrder     CustomerOrder   @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id])

  @@index([customerOrderId])
  @@index([productId])
}

model Shipment {
  id                String          @id @default(cuid())
  customerOrderId   String
  supplierId        String?
  courierName       String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  status            ShipmentStatus  @default(PENDING)
  shipmentCost      Decimal?        @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerOrder     CustomerOrder   @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  trackingEvents    TrackingEvent[]

  @@index([customerOrderId])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  eventType   String
  description String?
  eventTime   DateTime @default(now())
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ReturnRequest {
  orderItem          OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customer           User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierReceivedAt DateTime?
  orderItemId        String?
  customerId         String?
  adminNotes         String?
  receivedAt         DateTime?
  returnType         String        @default("CUSTOMER_RETURN")
  id                 String        @id @default(cuid())
  customerOrderId    String
  supplierId         String?
  reason             String?
  status             ReturnStatus  @default(OPEN)
  quantity           Int           @default(0)
  refundAmount       Decimal?      @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  refunds            Refund[]
  customerOrder      CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  supplier           Supplier?     @relation(fields: [supplierId], references: [id])
}

model Refund {
  gatewayRefundId String?       @unique
  id              String        @id @default(cuid())
  returnRequestId String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

model ProductCost {
  id            String   @id @default(cuid())
  productId     String
  costType      String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarketplaceFee {
  id              String          @id @default(cuid())
  marketplaceType MarketplaceType
  feeType         String
  rate            Decimal?        @db.Decimal(10, 4)
  fixedAmount     Decimal?        @db.Decimal(10, 2)
  effectiveFrom   DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([marketplaceType])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("INR")
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SyncJob {
  id                   String              @id @default(cuid())
  userId               String?
  marketplaceAccountId String?
  jobType              String
  status               SyncStatus          @default(PENDING)
  startedAt            DateTime?
  completedAt          DateTime?
  errorMessage         String?
  metadata             Json?
  createdAt            DateTime            @default(now())
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id])
  user                 User?               @relation(fields: [userId], references: [id])

  @@index([status])
}

model IntegrationLog {
  id              String          @id @default(cuid())
  marketplaceType MarketplaceType
  operation       String
  status          String
  requestBody     Json?
  responseBody    Json?
  errorMessage    String?
  createdAt       DateTime        @default(now())

  @@index([marketplaceType])
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  SUPPLIER
  STAFF
}

enum PermissionAction {
  READ
  WRITE
  DELETE
  APPROVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  TRANSIT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum ReturnStatus {
  OPEN
  APPROVED
  REJECTED
  COMPLETED
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum MarketplaceType {
  AMAZON
  FLIPKART
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  CREATED
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SupplierApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplierApprovalAction {
  MANUAL_APPROVAL
  AUTO_SUBMIT
  REJECTED
}

model CustomerAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  address   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IntegrationSetting {
  id                   String   @id @default(cuid())
  provider             String   @unique
  encryptedCredentials String
  options              Json?
  updatedAt            DateTime @updatedAt
}

model SupplierSettlement {
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  id         String   @id @default(cuid())
  supplierId String
  amount     Decimal  @db.Decimal(12, 2)
  reference  String
  notes      String?
  paidAt     DateTime
  createdAt  DateTime @default(now())

  @@unique([supplierId, reference])
  @@index([supplierId, paidAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  reply     String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CustomerVoucher {
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  id         String    @id @default(cuid())
  customerId String
  code       String    @unique
  balance    Decimal   @db.Decimal(12, 2)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}
