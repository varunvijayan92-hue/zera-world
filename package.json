{
  "name": "supplierbridge",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "db:generate": "prisma generate",
